{
  "name": "rocos-configurator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "test:ui": "playwright test",
    "test:compat": "playwright test --config playwright.compat.config.ts",
    "test:offline": "playwright test --config playwright.offline.config.ts",
    "package:offline": "npm run build -- --base ./ && node scripts/package-offline.mjs",
    "test:package": "node scripts/verify-offline-package.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:test:files": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --lib --locked",
    "desktop:test:ui": "node scripts/verify-desktop.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.0",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@tauri-apps/api": "2.12.4",
    "@xmldom/xmldom": "^0.8.11",
    "@xyflow/react": "12.12.0",
    "antd": "^5.27.0",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.2",
    "idb-keyval": "^6.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "three-viewport-gizmo": "2.2.0",
    "urdf-loader": "^0.12.6",
    "xml-formatter": "3.7.0",
    "yaml": "^2.8.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "version": "0.1.0-rc.25"
}
